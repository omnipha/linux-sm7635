'
log 'module load begin'
for module in $VENDOR_MODULES; do
	if err=$(insmod "/lib/modules/$module" 2>&1); then
		log "module $module loaded"
	else
		log "module $module failed: $err"
	fi
done
log 'module load end'

UDC=""
i=0
while [ "$i" -lt 40 ]; do
	for candidate in /sys/class/udc/*; do
		if [ -e "$candidate" ]; then
			UDC=${candidate##*/}
			break
		fi
	done
	[ -n "$UDC" ] && break
	sleep 0.25
	i=$((i + 1))
done

UDC_NAMES=""
for candidate in /sys/class/udc/*; do
	[ -e "$candidate" ] && UDC_NAMES="$UDC_NAMES ${candidate##*/}"
done
log "udc names:${UDC_NAMES:- none}"

if [ -z "$UDC" ]; then
	log 'no UDC; USB gadget not bound'
	n=0
	if [ -r /sys/kernel/debug/devices_deferred ]; then
		while read -r line && [ "$n" -lt 64 ]; do
			log "deferred probe pending: $line"
			n=$((n + 1))
		done </sys/kernel/debug/devices_deferred
	else
		log 'deferred probe list unavailable'
	fi
	log "deferred probe pending count logged: $n"
else
	G=/sys/kernel/config/usb_gadget/g1
	mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409"
	printf '0x18D1' >"$G/idVendor"
	printf '0x4EE2' >"$G/idProduct"
	printf '0x0100' >"$G/bcdDevice"
	printf '0x0200' >"$G/bcdUSB"
	printf 'omnipha' >"$G/strings/0x409/manufacturer"
	printf 'SM7635 USB debug' >"$G/strings/0x409/product"
	printf 'sm7635' >"$G/strings/0x409/serialnumber"
	printf 'NCM+ECM' >"$G/configs/c.1/strings/0x409/configuration"
	printf '250' >"$G/configs/c.1/MaxPower"
	mkdir -p "$G/functions/ncm.usb0" "$G/functions/ecm.usb0"
	ln -s "$G/functions/ncm.usb0" "$G/configs/c.1/"
	ln -s "$G/functions/ecm.usb0" "$G/configs/c.1/"
	if err=$({ printf '%s' "$UDC" >"$G/UDC"; } 2>&1); then
		log "gadget bound to $UDC"
		ip link set usb0 up 2>/dev/null || true
		ip addr add 172.16.42.2/24 dev usb0 2>/dev/null || true
		ip link set usb1 up 2>/dev/null || true
		ip addr add 172.16.43.2/24 dev usb1 2>/dev/null || true
	else
		log "gadget bind failed for $UDC: $err"
	fi
fi

mkdir -p /etc/dropbear /var/run
if /bin/dropbear -R -p 172.16.42.2:22 >/dev/console 2>&1; then
	log 'sshd listening at 172.16.42.2:22 (public key only)'
else
	log 'sshd failed to start'
fi
log 'console ready'
setsid cttyhack /bin/sh
