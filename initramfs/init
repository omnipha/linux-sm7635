#!/bin/busybox sh
set -u
export PATH=/bin:/sbin
export HOME=/root

log() { printf 'usb-init: %s\n' "$*" >/dev/kmsg 2>/dev/null || true; }

mkdir -p /proc /sys /dev /dev/pts /run /bin /sbin /root /etc /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	mount -t tmpfs devtmpfs /dev
fi
mount -t configfs configfs /sys/kernel/config
mount -t devpts devpts /dev/pts

[ -e /dev/null ] || mknod /dev/null c 1 3
[ -e /dev/zero ] || mknod /dev/zero c 1 5
[ -e /dev/console ] || mknod /dev/console c 5 1
[ -e /dev/kmsg ] || mknod /dev/kmsg c 1 11
[ -e /dev/ptmx ] || mknod /dev/ptmx c 5 2

printf 'root:x:0:0:root:/root:/bin/sh\n' >/etc/passwd
printf 'root:x:0:\n' >/etc/group
printf '/bin/sh\n' >/etc/shells
hostname omnipha-usb
log 'starting'
mkdir -p /sys/kernel/debug
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true

VENDOR_MODULES='
gh_arm_drv.ko
phy-qcom-ufs.ko
phy-qcom-ufs-qmp-v4-pineapple.ko
phy-qcom-ufs-qrbtc-sdm845.ko
